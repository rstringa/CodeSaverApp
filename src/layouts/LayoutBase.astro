---
import '@styles/highlight-js.css'
import '@styles/highlight-theme.css'
import '@styles/global.css'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { supabase } from '@lib/supabaseClient'
const { data: userSession } = await supabase.auth.getSession()
const userSessionId = userSession?.session?.user.id
---

<!doctype html>
<html lang="es-ES">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>CodeSaverApp - Tus snippets de código siempre a mano.</title>
		<meta name="description" content="Guarda, organiza y encuentra tus snippets de código en segundos. Categorías, búsqueda instantánea, highlight y acceso desde cualquier dispositivo. Gratis." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
		<style>code, pre, .font-mono{font-family:"JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;}</style>
	</head>
	<body
		class=`theme-atom-one-dark is-loading h-screen w-full bg-slate-900 text-slate-100
  ${userSessionId ? 'logged-in' : 'logged-out'}
  `
	>
		<Header />
		<slot />
		<Footer />
		<!-- <script
			defer
			src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs"
			type="module"></script> -->
	</body>
</html>
