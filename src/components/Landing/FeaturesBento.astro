---
import { Icon } from 'astro-icon/components'
const features = [
  { col:'lg:col-span-2', icon:'folderCode', title:'Categorías inteligentes', desc:'Crea carpetas ilimitadas, renombra al vuelo y filtra por categoría. Tu biblioteca, a tu manera.', accent:'bg-green-500/10 text-green-400' },
  { col:'', icon:'copy', title:'Copiar en 1 click', desc:'Botón copy con feedback. Pega directo en tu editor.', accent:'bg-blue-500/10 text-blue-400' },
  { col:'', icon:'heart', title:'Favoritos', desc:'Marca lo esencial. Accede a tus top snippets sin buscar.', accent:'bg-pink-500/10 text-pink-400' },
  { col:'lg:col-span-2', icon:'expand2', title:'Búsqueda instantánea', desc:'Busca por título, código o descripción. Resultados en <50ms, sin recargar.', accent:'bg-emerald-500/10 text-emerald-400' },
  { col:'', icon:'edit', title:'Edita & elimina', desc:'Todo editable. Historial limpio, control total.', accent:'bg-amber-500/10 text-amber-400' },
  { col:'lg:col-span-2', icon:'home', title:'Highlight + responsive', desc:'Atom One Dark, 100+ lenguajes con highlight.js. Perfecto en móvil y desktop.', accent:'bg-violet-500/10 text-violet-400' },
]
---

<section class="relative border-b border-slate-800 bg-slate-900 px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="mx-auto max-w-[1280px]">
    <div class="mb-8 flex flex-col gap-3 sm:mb-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-green-500">Características</p>
        <h2 class="mt-2 max-w-[18ch] text-[clamp(1.7rem,4vw,2.6rem)] font-black leading-none tracking-tighter text-slate-100">Todo lo que necesitas. <span class="text-slate-500">Nada que sobre.</span></h2>
      </div>
      <p class="max-w-[36ch] text-sm leading-relaxed text-slate-400">Diseñado para devs que odian perder tiempo buscando el mismo regex por tercera vez.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f,i) => (
        <article class={`group relative overflow-hidden rounded-[20px] border border-slate-700/50 bg-slate-800/50 p-6 backdrop-blur transition hover:-translate-y-1 hover:border-green-700/30 hover:shadow-[0_10px_40px_rgba(34,197,94,0.12)] ${f.col}`} style={`animation-delay:${i*70}ms`}>
          <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-white/[0.02] blur-xl group-hover:bg-green-500/10"></div>
          <div class={`inline-flex rounded-xl p-2.5 ${f.accent}`}>
            <Icon name={f.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-bold tracking-tight text-slate-100">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.desc}</p>
          <div class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-slate-500 group-hover:text-green-400">— <span class="h-px w-6 bg-current"></span></div>
        </article>
      ))}
    </div>
  </div>
</section>
